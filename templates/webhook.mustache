{{{allow_accounts_same_email_warning}}}

<p>{{#str}}webhook_desc, contentmarketplace_goone{{/str}}</p>

{{#webhook_exists}}
    {{#str}} webhook_already_created, contentmarketplace_goone {{/str}}
    <br />
    <pre>{{ webhook_data }}</pre>
    <br />
    {{#webhook_out_of_sync}}
        <div class="alert alert-warning">{{#str}}webhook_out_of_sync, contentmarketplace_goone{{/str}}</div>
    {{/webhook_out_of_sync}}
    <div class="singlebutton">
        <form method="post" action="{{update_webhook_url}}" id="go1updatewebhook">
            <div>
                <input type="submit" value="{{#str}}webhook_update, contentmarketplace_goone{{/str}}"{{#webhook_disabled}} disabled{{/webhook_disabled}} />
                <input type="hidden" name="tab" value="webhook" />
                <input type="hidden" name="action" value="update" />
                <input type="hidden" name="sesskey" value="{{sesskey}}" />
            </div>
        </form>
    </div>
{{/webhook_exists}}

{{^webhook_exists}}
<div class="singlebutton">
    <form method="post" action="{{create_webhook_url}}" id="go1createwebhook">
        <div>
            <input type="submit" value="{{#str}}webhook_create, contentmarketplace_goone{{/str}}"{{#webhook_disabled}} disabled{{/webhook_disabled}} />
            <input type="hidden" name="tab" value="webhook" />
            <input type="hidden" name="action" value="create" />
            <input type="hidden" name="sesskey" value="{{sesskey}}" />
        </div>
    </form>
</div>
{{/webhook_exists}}
